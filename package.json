{
  "name": "balance-wheel-app",
  "version": "1.0.0",
  "description": "Telegram Mini App — Balance Wheel with daily tracking",
  "scripts": {
    "dev": "concurrently \"npm:dev:bot\" \"npm:dev:server\" \"npm:dev:frontend\"",
    "dev:bot": "node bot/index.js",
    "dev:server": "node backend/server.js",
    "dev:frontend": "cd frontend && npx vite dev --port 5174",
    "build": "cd frontend && npx vite build",
    "start": "node backend/server.js & node bot/index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "vite": "^5.4.0"
  }
}
